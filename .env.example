# Configuration de l'application
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Africa/Lubumbashi
BASE_URL=http://localhost:8000/

# Base de données MySQL / MariaDB
DB_SERVER=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=kingandqween

# Sécurité et Sessions
SESSION_SECRET=changez_cette_cle_secrete_par_une_valeur_aleatoire_de_64_caracteres
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Politiques d'annulation par défaut (en heures)
CLIENT_CANCEL_POLICY_HOURS=24
COIFFEUR_CANCEL_POLICY_HOURS=12

# Configuration SMTP (PHPMailer)
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_EMAIL=no-reply@kingandqween.com
MAIL_FROM_NAME="King and Qween Salon"
